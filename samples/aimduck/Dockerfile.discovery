FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY client/package.json client/package.json
COPY services/discovery/package.json services/discovery/package.json
COPY services/room/package.json services/room/package.json
RUN npm ci
COPY . .
RUN npm run build --workspace @aimduck/discovery

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/services/discovery/package.json ./services/discovery/package.json
COPY --from=build /app/services/discovery/dist ./services/discovery/dist
USER node
EXPOSE 8443
HEALTHCHECK --interval=10s --timeout=3s --retries=10 CMD node -e "require('https').get({hostname:'127.0.0.1',port:8443,path:'/readyz',rejectUnauthorized:false},r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "services/discovery/dist/main.js"]
