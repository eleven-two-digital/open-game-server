# SPDX-License-Identifier: Apache-2.0

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY client/package.json client/package.json
COPY services/discovery/package.json services/discovery/package.json
COPY services/room/package.json services/room/package.json
RUN npm ci
COPY . .
ARG VITE_DISCOVERY_URL=https://localhost:8080
ARG VITE_OIDC_AUTHORITY=http://localhost:8180/realms/aimduck
ARG VITE_OIDC_CLIENT_ID=aimduck-browser
ENV VITE_DISCOVERY_URL=${VITE_DISCOVERY_URL}
ENV VITE_OIDC_AUTHORITY=${VITE_OIDC_AUTHORITY}
ENV VITE_OIDC_CLIENT_ID=${VITE_OIDC_CLIENT_ID}
RUN npm run build --workspace @aimduck/shared && npm run build --workspace @aimduck/client

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY client/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/client/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=10 CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
